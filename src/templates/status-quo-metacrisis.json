    {
      "title": "Survival Strategies (Coping Mechanisms)",
      "columns": [
        {
          "nodes": [
            {
              "id": "strategy-numbing",
              "text": "Addiction to substances, entertainment, porn. A way to stop feeling what the unmet need would otherwise make felt. (Maté)",
              "title": "Craving for numbing",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 23,
              "provenance": "interpreted",
              "connections": [
                {
                  "targetId": "driver-erosion-sensemaking",
                  "evidence": "Arrow drawn from this strategy cluster into the metacrisis-drivers column, landing near \"erosion of collective sensemaking\".",
                  "provenance": "interpreted",
                  "assumptions": "Several strategy boxes converge on this area of the drivers column; exact 1:1 source→target pairing not fully resolvable from the photo."
                },
                {
                  "targetId": "driver-collective-disempowerment",
                  "evidence": "Short arrows from numbing into the first drivers (open question 5).",
                  "provenance": "interpreted"
                }
              ]
            },
            {
              "id": "strategy-control-supremacy",
              "text": "\"Supremacy.\" Safety sought through domination: if I am on top, nobody can hurt me. Collectively, the claim to superiority over others.",
              "title": "Craving for control, safety, immunity",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 133,
              "provenance": "interpreted",
              "connections": [
                {
                  "targetId": "driver-racism-colonialism",
                  "evidence": "Arrow from this strategy toward \"racism + (post)colonialism\".",
                  "provenance": "interpreted"
                },
                {
                  "targetId": "driver-lacking-willingness-change",
                  "evidence": "Short arrow from control/supremacy into the first drivers.",
                  "provenance": "interpreted"
                }
              ]
            },
            {
              "id": "strategy-scapegoating",
              "text": "Unbearable inner states are placed on an outside person or group, who is then blamed and attacked.",
              "title": "Scape goating, projection the blame",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 273,
              "provenance": "interpreted",
              "connections": [
                {
                  "targetId": "driver-racism-colonialism",
                  "evidence": "Arrow from this strategy toward \"racism + (post)colonialism\".",
                  "provenance": "interpreted"
                }
              ],
              "links": [
                {
                  "url": "https://en.wikipedia.org/wiki/Scapegoating",
                  "label": "Wikipedia: Scapegoating"
                }
              ]
            },
            {
              "id": "strategy-craving-seen",
              "text": "A hunger for attention and recognition.",
              "title": "Craving to be seen?",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 377,
              "provenance": "interpreted",
              "connections": []
            },
            {
              "id": "strategy-craving-power",
              "text": "Having concluded that nobody can be trusted, the person tries to hold power over the situation instead of depending on others.",
              "title": "Craving for power: \"nobody can be trusted\"",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 481,
              "provenance": "interpreted",
              "connections": [
                {
                  "targetId": "group-multipolar-traps",
                  "evidence": "Arrow into the bracketed multipolar-traps/race-to-bottom/race-to-market/arms-race cluster.",
                  "provenance": "interpreted"
                }
              ]
            },
            {
              "id": "strategy-compulsive-soothing",
              "text": "Food, work etc. or regulate / shopping. Habits used to calm down in place of the comfort once missing. The need stays unmet, so the habit repeats and grows. (Maté)",
              "title": "Compulsive soothing",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 608,
              "provenance": "interpreted",
              "connections": [
                {
                  "targetId": "group-multipolar-traps",
                  "evidence": "Crossing arrows from compulsive soothing on the board.",
                  "provenance": "interpreted"
                },
                {
                  "targetId": "group-consumerism",
                  "evidence": "Crossing arrows from compulsive soothing on the board.",
                  "provenance": "interpreted"
                }
              ]
            },
            {
              "id": "strategy-greed-more",
              "text": "A feeling of never having enough that stays hungry however much arrives.",
              "title": "Greed, craving for \"more\"",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 711,
              "provenance": "interpreted",
              "connections": [
