                  "url": "https://en.wikipedia.org/wiki/Contingent_self-esteem",
                  "label": "Wikipedia: Contingent self-esteem"
                }
              ]
            },
            {
              "id": "strategy-narcissism",
              "text": "A grand self-image defends against feeling unworthy and needs constant admiration.",
              "title": "Narcissism",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 1036,
              "provenance": "interpreted",
              "connections": [
