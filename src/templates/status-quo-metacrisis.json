              "links": [
                {
                  "url": "https://en.wikipedia.org/wiki/Greed",
                  "label": "Wikipedia: Greed"
                }
              ]
            },
            {
              "id": "strategy-fear-dependence-separation",
              "text": "Urge towards \"separation.\" Needing others feels dangerous, so closeness is avoided and distance is treated as safety.",
              "title": "Fear of dependence, urge towards \"separation\"",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 815,
              "provenance": "interpreted",
              "connections": [
                {
                  "targetId": "group-consumerism",
                  "evidence": "Arrow into the consumerism/individualism cluster.",
                  "provenance": "interpreted"
                }
              ]
            },
            {
              "id": "strategy-perform-worth",
              "text": "Career, status, money. Worth is felt to depend on results, so the person achieves in order to be loved.",
              "title": "Perform (to be loved, worthy)",
              "color": "#FFF3E0",
              "width": 330,
              "yPosition": 918,
              "provenance": "interpreted",
